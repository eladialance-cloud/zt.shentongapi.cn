# =============================================================================
# 深瞳AI 全栈部署 - 生产环境环境变量模板
#
# 生成强密码: openssl rand -base64 24
# 生成密钥:   openssl rand -hex 32
#
# 使用方法: cp .env.production.template .env && 填入真实值
# =============================================================================

# ---------- MySQL 配置 ----------
# 数据库 root 密码
MYSQL_ROOT_PASSWORD=                # 必填,至少16字符
# 数据库名称
MYSQL_DATABASE=ai_agent             # 选填,默认 ai_agent
# 数据库用户名
MYSQL_USER=shentong                 # 选填,默认 shentong
# 应用数据库用户密码
MYSQL_PASSWORD=                     # 必填,至少16字符

# ---------- Redis 配置 ----------
# Redis 访问密码
REDIS_PASSWORD=                     # 必填,至少16字符

# ---------- JWT 密钥 ----------
# 用户端 JWT 密钥(生产环境务必修改,至少 32 字符)
JWT_SECRET=                         # 必填,至少32字符,用 openssl rand -hex 32 生成
# Access Token 过期时间
JWT_EXPIRES_IN=15m                  # 选填,默认 15m
# Refresh Token 过期时间
JWT_REFRESH_EXPIRES_IN=7d            # 选填,默认 7d

# ---------- Admin 管理后台 JWT ----------
# 管理后台独立密钥(与用户端隔离)
ADMIN_JWT_SECRET=                   # 必填,至少32字符,用 openssl rand -hex 32 生成
# Admin Token 过期时间
ADMIN_JWT_EXPIRES_IN=8h             # 选填,默认 8h

# ---------- 加密密钥 ----------
# AES 加密密钥(32字节 hex,64字符)
AES_KEY=                            # 必填,64字符 hex,用 openssl rand -hex 32 生成
# HMAC 签名密钥(64字符)
HMAC_SECRET=                        # 必填,64字符,用 openssl rand -hex 32 生成

# ---------- 网络配置 ----------
# CORS 允许的源(多个用逗号分隔,* 表示允许所有,生产环境建议指定域名)
CORS_ORIGINS=                       # 选填,建议指定具体域名

# ---------- 限流配置 ----------
THROTTLE_TTL=60000                  # 选填,默认 60000ms
THROTTLE_LIMIT=60                   # 选填,默认 60 次

# ---------- Swagger 文档 ----------
SWAGGER_PATH=api/docs               # 选填,默认 api/docs
