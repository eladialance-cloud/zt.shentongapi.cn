# =============================================================================
# 娣辩灣AI 鍏ㄦ爤鐜鍙橀噺
# 浣跨敤鏂规硶: cp .env.example .env && 淇敼瀵嗙爜涓庡瘑閽?# =============================================================================

# MySQL 閰嶇疆
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
MYSQL_DATABASE=ai_agent
MYSQL_USER=shentong
MYSQL_PASSWORD=shentong_pwd_2026

# Redis 閰嶇疆
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# JWT 瀵嗛挜(鐢熶骇鐜鍔″繀淇敼,鑷冲皯 32 瀛楃)
JWT_SECRET=change-me-in-production-at-least-32-chars-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin 绠＄悊鍚庡彴 JWT(鐙珛瀵嗛挜,涓庣敤鎴风闅旂)
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-32-chars
ADMIN_JWT_EXPIRES_IN=8h

# AES 鍔犲瘑瀵嗛挜(鑷冲皯 16 瀛楃锛岀敤浜?API Key 姹犵瓑鏁忔劅鏁版嵁鍔犲瘑)
AES_KEY=CHANGE_ME_TO_AES_KEY_AT_LEAST_16_CHARS

# HMAC 楠岀瀵嗛挜(鑷冲皯 16 瀛楃锛岀敤浜庢帴鍙ｇ鍚嶆牎楠?
HMAC_SECRET=CHANGE_ME_TO_HMAC_SECRET_AT_LEAST_16

# CORS 鍏佽鐨勬簮(澶氫釜鐢ㄩ€楀彿鍒嗛殧锛岀敓浜х幆澧冪鐢?*)
CORS_ORIGINS=https://zt.shentongapi.cn

# 闄愭祦閰嶇疆
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Swagger 鏂囨。璺緞
SWAGGER_PATH=api/docs

# Payment - WeChat Pay V3
# 寰俊鏀粯 V3 鍟嗘埛鍑瘉锛堜粠寰俊鏀粯鍟嗘埛骞冲彴鑾峰彇锛?WECHAT_APP_ID=              # 寰俊鏀粯 AppID锛堝叕浼楀彿/灏忕▼搴?AppID锛?WECHAT_MCH_ID=              # 寰俊鏀粯鍟嗘埛鍙?WECHAT_API_V3_KEY=          # APIv3 瀵嗛挜锛?2瀛楃锛屽晢鎴峰钩鍙拌缃級
WECHAT_SERIAL_NO=           # 鍟嗘埛璇佷功搴忓垪鍙?WECHAT_PRIVATE_KEY_PATH=/app/certs/wechat_merchant_private_key.pem  # 鍟嗘埛绉侀挜鏂囦欢璺緞锛圖ocker 瀹瑰櫒鍐咃級
WECHAT_PUBLIC_KEY_PATH=/app/certs/wechat_platform_cert.pem          # 寰俊骞冲彴璇佷功璺緞
WECHAT_NOTIFY_URL=https://zt.shentongapi.cn/api/payments/callback/wechat  # 鏀粯鍥炶皟閫氱煡鍦板潃

# Payment - Alipay
# 鏀粯瀹濆綋闈粯鍑瘉锛堜粠鏀粯瀹濆紑鏀惧钩鍙拌幏鍙栵級
ALIPAY_APP_ID=              # 鏀粯瀹濆簲鐢?ID
ALIPAY_PRIVATE_KEY=         # 搴旂敤绉侀挜锛圧SA2锛?ALIPAY_PUBLIC_KEY=          # 鏀粯瀹濆叕閽ワ紙RSA2锛?ALIPAY_NOTIFY_URL=https://zt.shentongapi.cn/api/payments/callback/alipay  # 鏀粯鍥炶皟閫氱煡鍦板潃

# Payment - Stripe
# Stripe 鍑瘉锛堜粠 Stripe Dashboard 鑾峰彇锛?STRIPE_SECRET_KEY=          # Stripe Secret Key (sk_live_xxx)
STRIPE_WEBHOOK_SECRET=      # Stripe Webhook Signing Secret (whsec_xxx)

# =============================================================================
# Qdrant 鍚戦噺鏁版嵁搴撻厤缃?# =============================================================================
# Qdrant REST API 鍦板潃锛圖ocker 鍐呴儴缃戠粶浣跨敤瀹瑰櫒鍚嶏紝澶栭儴璁块棶鐢?127.0.0.1锛?QDRANT_URL=http://localhost:6333
