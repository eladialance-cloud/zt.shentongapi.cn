# =============================================================================
# 深瞳AI 全栈环境变量
# 使用方法: cp .env.example .env && 修改密码与密钥
# =============================================================================

# MySQL 配置
MYSQL_ROOT_PASSWORD=change-me-to-strong-password
MYSQL_DATABASE=ai_agent
MYSQL_USER=shentong
MYSQL_PASSWORD=change-me-to-strong-password

# Redis 配置
REDIS_PASSWORD=change-me-to-strong-password

# JWT 密钥(生产环境务必修改,至少 32 字符)
JWT_SECRET=change-me-in-production-at-least-32-chars-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin 管理后台 JWT(独立密钥,与用户端隔离)
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-32-chars
ADMIN_JWT_EXPIRES_IN=8h

# AES 加密密钥(至少 16 字符，用于 API Key 池等敏感数据加密)
AES_KEY=change-me-to-aes-key-at-least-16-chars

# HMAC 验签密钥(至少 16 字符，用于接口签名校验)
HMAC_SECRET=change-me-to-hmac-secret-at-least-16

# CORS 允许的源(多个用逗号分隔，生产环境禁用 *)
CORS_ORIGINS=https://zt.shentongapi.cn

# 限流配置
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Swagger 文档路径
SWAGGER_PATH=api/docs

# Payment - WeChat Pay V3
# 微信支付 V3 商户凭证（从微信支付商户平台获取）
WECHAT_APP_ID=              # 微信支付 AppID（公众号/小程序 AppID）
WECHAT_MCH_ID=              # 微信支付商户号
WECHAT_API_V3_KEY=          # APIv3 密钥（32字符，商户平台设置）
WECHAT_SERIAL_NO=           # 商户证书序列号
WECHAT_PRIVATE_KEY_PATH=/app/certs/wechat_merchant_private_key.pem  # 商户私钥文件路径（Docker 容器内）
WECHAT_PUBLIC_KEY_PATH=/app/certs/wechat_platform_cert.pem          # 微信平台证书路径
WECHAT_NOTIFY_URL=https://zt.shentongapi.cn/api/payments/callback/wechat  # 支付回调通知地址

# Payment - Alipay
# 支付宝当面付凭证（从支付宝开放平台获取）
ALIPAY_APP_ID=              # 支付宝应用 ID
ALIPAY_PRIVATE_KEY=         # 应用私钥（RSA2）
ALIPAY_PUBLIC_KEY=          # 支付宝公钥（RSA2）
ALIPAY_NOTIFY_URL=https://zt.shentongapi.cn/api/payments/callback/alipay  # 支付回调通知地址

# Payment - Stripe
# Stripe 凭证（从 Stripe Dashboard 获取）
STRIPE_SECRET_KEY=          # Stripe Secret Key (sk_live_xxx)
STRIPE_WEBHOOK_SECRET=      # Stripe Webhook Signing Secret (whsec_xxx)

# =============================================================================
# Qdrant 向量数据库配置
# =============================================================================
# Qdrant REST API 地址（Docker 内部网络使用容器名，外部访问用 127.0.0.1）
QDRANT_URL=http://localhost:6333
