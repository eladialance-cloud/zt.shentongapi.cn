# =============================================================================
# 深瞳AI 全栈部署环境变量
# 使用方法:cp .env.example .env && 修改密码与密钥
# =============================================================================

# MySQL 配置
MYSQL_ROOT_PASSWORD=change-me-root-strong-password
MYSQL_DATABASE=ai_agent
MYSQL_USER=shentong
MYSQL_PASSWORD=change-mysql-user-password

# Redis 配置
REDIS_PASSWORD=change-redis-password

# JWT 密钥(生产环境务必修改,至少 32 字符)
JWT_SECRET=change-me-to-random-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin 管理后台 JWT(独立密钥,与用户端隔离)
ADMIN_JWT_SECRET=change-me-to-different-random-64-chars
ADMIN_JWT_EXPIRES_IN=8h

# AES 加密密钥(32字节 hex,64字符)
AES_KEY=change-me-to-random-64-hex-chars

# HMAC 签名密钥(64字符)
HMAC_SECRET=change-me-to-random-64-chars

# CORS 允许的源(多个用逗号分隔,* 表示允许所有)
CORS_ORIGINS=https://zt.shentongapi.cn,http://localhost:5173,http://localhost:5174

# 限流配置
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Swagger 文档路径
SWAGGER_PATH=api/docs
