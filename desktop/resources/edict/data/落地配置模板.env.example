# =============================================================================
# 深瞳 · AI 数字员工 落地配置模板（.env 填空版）
# -----------------------------------------------------------------------------
# 用途：部署工程师照此填空即可拉起 12 角色（三省六部 + 太子 + 钦天监 + 早朝简报官）。
# 用法：复制本文件为 .env，填完再启动桌面端 / Hermes 服务。
# 约定：本模板只列键名与占位符，禁止填入真实密钥（AppId/Secret/Token/密码一律留空或 <必填>）。
#       凡由平台设置/客户端 UI 注入的项不要在此填写，会被运行时覆盖。
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# 【0】渲染层 / 前端（Vite）—— 必填
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=<必填>                 # 后端/网关 API 地址
VITE_WS_URL=<必填>                        # WebSocket 地址
VITE_ADMIN_BASE_URL=<可选>                # 管理后台地址
VITE_DEVTOOLS_ENABLED=false               # 开发工具开关


# ─────────────────────────────────────────────────────────────────────────────
# 【1】云端 / 网关（Hermes）—— 必填
# ─────────────────────────────────────────────────────────────────────────────
ST_API_BASE=<必填>                        # 云端 API 地址（默认 https://zt.shentongapi.cn/api）
ST_AUTH_FILE=<必填>                       # 云端登录信息文件路径（含 token，勿写入明文）
ST_CLAW_BASE_URL=http://127.0.0.1:8000    # 深瞳 claw 本地服务地址
SHENTONG_SANDBOX_BACKEND=0                # 沙箱后端开关（1 或 0）


# ─────────────────────────────────────────────────────────────────────────────
# 【2】N8N 工作流引擎 —— 秘书简报/海报/确定性操作依赖
# ─────────────────────────────────────────────────────────────────────────────
N8N_BASE_URL=http://127.0.0.1:5678        # 本地 N8N 实例地址
N8N_API_KEY=<必填>                        # N8N API Key（勿写真实值）
N8N_POSTER_SUBMIT_WEBHOOK_URL=<可选>      # 海报/简报提交 webhook
N8N_POSTER_QUERY_WEBHOOK_URL=<可选>       # 海报/简报查询 webhook


# ─────────────────────────────────────────────────────────────────────────────
# 【3】Hermes / 军机处 运行时 —— 必填
# ─────────────────────────────────────────────────────────────────────────────
HERMES_HOME=<必填>                        # Hermes 用户目录（SOUL/配置/凭据集中）
HERMES_PYTHON=<可选>                      # Hermes 内置 Python 解释器路径
HERMES_NODE=<可选>                        # Hermes 内置 Node 路径
HERMES_ENTRY=<可选>                       # Hermes 入口脚本路径
EDICT_HOME=<必填>                         # 军机处/edict 数据目录（schema/tasks/kanban）


# ─────────────────────────────────────────────────────────────────────────────
# 【4】深瞳自动触达 / 对话工具（原 wxauto 类工具，去品牌后口径）
# -----------------------------------------------------------------------------
# 说明：由客户端「平台设置」配置后经 forkEnv 注入，此处留空即可；不要手动填写。
# ─────────────────────────────────────────────────────────────────────────────
ST_AUTOREACH_PORT=<必填>                  # 深瞳自动触达服务端口
ST_AUTOREACH_TOKEN=<必填>                 # 深瞳自动触达鉴权 Token（勿写真实值）
ST_AUTOREACH_BASE_URL=http://127.0.0.1    # 深瞳自动触达服务地址


# ─────────────────────────────────────────────────────────────────────────────
# 【5】外部渠道绑定（飞书 / 企业微信 机器人）
# -----------------------------------------------------------------------------
# 说明：同样由客户端「平台设置」配置后经 forkEnv 注入，此处留空即可。
# ─────────────────────────────────────────────────────────────────────────────
FEISHU_APP_ID=<必填>                      # 飞书开放平台应用 ID（勿写真实值）
FEISHU_APP_SECRET=<必填>                  # 飞书开放平台应用密钥（勿写真实值）
FEISHU_CHANNEL_ENABLED=false              # 飞书渠道开关
WECOM_CHANNEL_ENABLED=false               # 企业微信渠道开关


# ─────────────────────────────────────────────────────────────────────────────
# 【6】持久化 / 数据库（可选，双写同步时必填）
# ─────────────────────────────────────────────────────────────────────────────
ST_MYSQL_HOST=<可选>                      # 数据库主机
ST_MYSQL_USER=<可选>                      # 数据库用户名
ST_MYSQL_PWD=<可选>                       # 数据库密码（勿写真实值）
ST_MYSQL_DB=<可选>                        # 数据库名


# ─────────────────────────────────────────────────────────────────────────────
# 【7】数据表 / 看板绑定（可选，覆盖默认路径)
# ─────────────────────────────────────────────────────────────────────────────
EDICT_SCHEMA_FILE=<可选>                  # 军机处 schema.json 路径
EDICT_TASKS_FILE=<可选>                   # 军机处 tasks_source.json 路径
KANBAN_SCRIPT=<可选>                      # kanban_update.py 路径


# =============================================================================
# 部署收尾
# =============================================================================
# 1. 填完上述必填项后启动客户端 → 军机处自动初始化 12 角色与看板。
# 2. 在客户端「平台设置」填写飞书/自动触达信息（forkEnv 注入，覆盖上表对应键）。
# 3. 自检：触发首条定时任务（如 06:00 尚书省作战地图），确认任务主表写入记录。
# =============================================================================
