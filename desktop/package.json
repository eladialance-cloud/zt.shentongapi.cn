{
  "name": "shentong-ai-desktop",
  "version": "2.0.15",
  "description": "shentong AI desktop app",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "tsx scripts/verify-electron.ts --repair",
    "predev": "tsx scripts/verify-electron.ts --check && npm run build:toolbox",
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build && npm run build:toolbox",
    "build:win": "npm run build && npm run build:sandbox-runner && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:toolbox": "node scripts/build-unified-toolbox.mjs",
    "lint": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "jest",
    "test:e2e": "jest --config jest.config.ts --testPathPattern=tests/e2e",
    "fetch-runtime": "tsx scripts/fetch-runtime.ts",
    "pack:win": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1 -Target win",
    "pack:mac": "bash scripts/build-installer.sh --target mac",
    "pack:all": "bash scripts/build-installer.sh --target all",
    "gen-latest-yml": "tsx scripts/generate-latest-yml.ts",
    "verify-installer": "tsx scripts/verify-installer.ts",
    "setup:electron": "tsx scripts/verify-electron.ts --repair",
    "build:sandbox-runner": "node scripts/build-sandbox-runner.mjs",
    "build:n8n": "tsx scripts/build-n8n-templates.mts",
    "import:n8n": "tsx scripts/import-n8n-workflows.mts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@esotericsoftware/spine-pixi-v8": "~4.2.0",
    "@journeyapps/sqlcipher": "^6.0.0",
    "antd": "^5.21.6",
    "axios": "^1.7.7",
    "border-beam": "^1.3.0",
    "date-fns": "^3.6.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.3.0",
    "lucide-react": "^1.27.0",
    "pixi.js": "^8.19.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.27.0",
    "react-syntax-highlighter": "^15.6.6",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.1",
    "tree-kill": "^1.2.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.5"
  }
}
