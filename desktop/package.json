{
    "name":  "shentong-ai-desktop",
    "version": "0.5.9",
    "description":  "shentong AI desktop app",
    "license":  "MIT",
    "main":  "dist/main/index.js",
    "scripts":  {
                    "postinstall":  "tsx scripts/verify-electron.ts --repair",
                    "predev":  "tsx scripts/verify-electron.ts --check",
                    "dev":  "electron-vite dev",
                    "build":  "tsc --noEmit -p tsconfig.node.json \u0026\u0026 tsc --noEmit -p tsconfig.web.json \u0026\u0026 electron-vite build",
                    "build:win":  "npm run build \u0026\u0026 electron-builder --win",
                    "build:mac":  "npm run build \u0026\u0026 electron-builder --mac",
                    "lint":  "tsc --noEmit -p tsconfig.node.json \u0026\u0026 tsc --noEmit -p tsconfig.web.json",
                    "typecheck":  "tsc --noEmit -p tsconfig.node.json \u0026\u0026 tsc --noEmit -p tsconfig.web.json",
                    "test":  "jest",
                    "test:e2e":  "jest --config jest.config.ts --testPathPattern=tests/e2e",
                                            "fetch-runtime":  "tsx scripts/fetch-runtime.ts",
                    "pack:win":  "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1 -Target win",
                    "pack:mac":  "bash scripts/build-installer.sh --target mac",
                    "pack:all":  "bash scripts/build-installer.sh --target all",
                    "gen-latest-yml":  "tsx scripts/generate-latest-yml.ts",
                    "verify-installer":  "tsx scripts/verify-installer.ts",
                    "setup:electron":  "tsx scripts/verify-electron.ts --repair"
                },
    "dependencies":  {
                         "@ant-design/icons":  "^5.5.1",
                         "@journeyapps/sqlcipher":  "^6.0.0",
                         "antd":  "^5.21.6",
                         "axios":  "^1.7.7",
                         "electron-log":  "^5.2.0",
                         "electron-updater":  "^6.3.9",
                         "lucide-react":  "^1.26.0",
                         "pixi.js":  "^8.6.6",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "react-router-dom":  "^6.27.0",
                         "socket.io-client":  "^4.8.1",
                         "tree-kill":  "^1.2.2",
                         "zustand":  "^4.5.5"
                     },
    "devDependencies":  {
                            "@testing-library/jest-dom":  "^6.9.1",
                            "@types/jest":  "^29.5.14",
                            "@types/node":  "^22.7.5",
                            "@types/react":  "^18.3.12",
                            "@types/react-dom":  "^18.3.1",
                            "@vitejs/plugin-react":  "^6.0.0",
                            "electron":  "^41.7.1",
                            "electron-builder":  "^26.15.3",
                            "electron-vite":  "^5.0.0",
                            "jest":  "^29.7.0",
                            "jest-environment-jsdom":  "^29.7.0",
                            "ts-jest":  "^29.4.11",
                            "ts-node":  "^10.9.2",
                            "tsx":  "^4.19.0",
                            "typescript":  "^5.6.3",
                            "vite":  "^8.1.5"
                        }
}
