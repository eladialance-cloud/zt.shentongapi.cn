{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./electron/shared/*"],
      "js-yaml": ["./electron/main/service-registry/js-yaml.d.ts"],
      "@journeyapps/sqlcipher": ["./types/sqlcipher.d.ts"]
    }
  },
  "include": ["electron/**/*.ts", "scripts/**/*"]
}
