{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./electron/shared/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "electron/shared/**/*.ts", "tests/**/*.ts"],
  "exclude": [
    "src/api/sync-api.ts",
    "src/pages/Automation",
    "src/pages/Settings/RemoteControl.tsx",
    "src/pages/Settings/SyncStatus.tsx",
    "src/services/office-ws.ts",
    "src/store/__tests__/state-machine.test.ts",
    "src/utils/__tests__/astar.test.ts",
    "src/pages/admin/Layout",
    "src/pages/Office",
    "src/router/index.tsx",
    "src/pages/Office/types.ts",
    "src/**/__tests__"
  ]
}
